```mermaid
flowchart TD
    %% ─────────────────────────────────────────────
    %% INPUTS
    %% ─────────────────────────────────────────────
    FASTA["Reference FASTA\n(harmonized database)"]
    PRIMERS["Primer table\n(.tsv — fwd/rev sequences)"]
    OTL["Operational Taxonomic List\n(OTL — .tsv per country)"]

    %% ─────────────────────────────────────────────
    %% STAGE 1 — DATA IMPORT
    %% ─────────────────────────────────────────────
    subgraph S1["① Reference Database Import"]
        CFI["CustomFastaImport\n• read_fasta()\n• pre_process_harmonized_fasta_database()"]
        VAL["Validate input\n(path, format, size)"]
        TAXID["Add / check TaxIDs\nfrom FASTA headers"]
        PREPROC["Pre-process:\nclean ASCII, deduplicate"]
    end

    FASTA --> CFI
    CFI --> VAL --> TAXID --> PREPROC

    %% ─────────────────────────────────────────────
    %% STAGE 2 — IN SILICO AMPLIFICATION
    %% ─────────────────────────────────────────────
    subgraph S2["② In Silico Amplification  (InSilicoAmplification)"]
        ISA_INIT["Setup output directories\n(amplicon / insert / pbs / incomplete_pbs)"]
        CHECK["Check tools installed\n(cutadapt, CRABS)"]
        READ_PT["read_primer_tables()\ncompute max amplicon length"]
        LOOP["For each primer pair…"]
        CUTADAPT["cutadapt\ntrim primers → amplicons"]
        PGA["PGA alignment\n(min identity ≥ threshold)"]
        FILTER_PBS["Filter sequences\nby ambiguity %"]
        OUT_DIRS["Outputs:\n• amplicon/\n• insert/filtered/\n• all_complete_pbs/filtered/\n• incomplete_pbs/filtered/"]
    end

    PREPROC --> ISA_INIT
    PRIMERS --> ISA_INIT
    ISA_INIT --> CHECK --> READ_PT --> LOOP
    LOOP --> CUTADAPT --> PGA --> FILTER_PBS --> OUT_DIRS

    %% ─────────────────────────────────────────────
    %% STAGE 3 — METRICS EVALUATION
    %% ─────────────────────────────────────────────
    subgraph S3["③ Metrics System  (MetricsSystemExecutor)"]

        subgraph LOOP_OTL["evaluate_several_OTLs()  — iterates per country OTL"]

            OTL_PROC["OtlHandler\n• validate_otl()\n• pre_process_otl()\n  (keep family / genus / species)\n• create_taxonomic_hierarchy()"]

            subgraph CAT1["Category 1 — Reference Database Quality"]
                RDQ["ReferenceDatabaseQuality\n• parse_fasta_files()\n• calculate_number_of_barcodes()"]
                M1A["barcoded_taxa_one_plus\n(% taxa with ≥1 barcode)"]
                M1B["ratio_barcoded_taxa\n(high-coverage / low-coverage)"]
                RDQ --> M1A & M1B
            end

            subgraph CAT2["Category 2 — Binding"]
                BIND["Binding\n• get_pbs_table()\n• primer_pbs_analysis()"]
                M2A["mismatch_score\n(sum of max mismatches)"]
                M2B["priming_ratio_sum\n(3′ mismatches / total)"]
                M2C["gc_clamp_score\n(GC matches at 3′ end)"]
                M2D["min_tm_cv\n(Tm coefficient of variation)"]
                BIND --> M2A & M2B & M2C & M2D
            end

            subgraph CAT3["Category 3 — Traits & Resolution"]
                CATNIP["TraitsAndResolution\n• run_catnip() — pairwise divergence\n• post_process_catnip_primer_results()"]
                M3A["taxonomic_resolution\n(% taxa divergence > 2%)"]
                M3B["resolution_ratio\n(divergence > cutoff / total taxa)"]
                CATNIP --> M3A & M3B
            end

            OTL_PROC --> RDQ & BIND & CATNIP
        end

    end

    OTL --> OTL_PROC
    OUT_DIRS --> RDQ
    OUT_DIRS --> BIND
    OUT_DIRS --> CATNIP

    %% ─────────────────────────────────────────────
    %% STAGE 4 — RANKING
    %% ─────────────────────────────────────────────
    subgraph S4["④ Primer Ranking"]
        RANK_MODE{"ranking_mode?"}
        FLAT["rank_primers_flat()\nAll metrics weighted equally"]
        CATW["rank_primers_categorically_weighted()\nWeighted by category"]
        INTER["Save intermediate_ranks\n(per-metric rank scores)"]
        FINAL["Final ranked output\n{country}_ranked_primers.tsv"]
        SORT["sort_otl_level_results()\nOrganise per country"]
    end

    M1A & M1B --> RANK_MODE
    M2A & M2B & M2C & M2D --> RANK_MODE
    M3A & M3B --> RANK_MODE

    RANK_MODE -- flat --> FLAT
    RANK_MODE -- category --> CATW
    FLAT & CATW --> INTER --> FINAL --> SORT

    %% ─────────────────────────────────────────────
    %% OUTPUT
    %% ─────────────────────────────────────────────
    SORT --> RESULT["Ranked primer list\nper country / OTL"]

    %% ─────────────────────────────────────────────
    %% STYLING
    %% ─────────────────────────────────────────────
    classDef input     fill:#e1f5ee,stroke:#0f6e56,color:#085041,font-weight:500
    classDef stage1    fill:#f0f4ff,stroke:#4a6db5,color:#1a3a6b
    classDef stage2    fill:#fff8e6,stroke:#ba7517,color:#633806
    classDef stage3    fill:#f5f0ff,stroke:#534ab7,color:#26215c
    classDef stage4    fill:#fef6f0,stroke:#993c1d,color:#4a1b0c
    classDef metric    fill:#eef9f4,stroke:#1d9e75,color:#085041,font-size:12px
    classDef output    fill:#e1f5ee,stroke:#0f6e56,color:#085041,font-weight:600
    classDef decision  fill:#faeeda,stroke:#ba7517,color:#412402

    class FASTA,PRIMERS,OTL input
    class CFI,VAL,TAXID,PREPROC stage1
    class ISA_INIT,CHECK,READ_PT,LOOP,CUTADAPT,PGA,FILTER_PBS,OUT_DIRS stage2
    class OTL_PROC,RDQ,BIND,CATNIP stage3
    class M1A,M1B,M2A,M2B,M2C,M2D,M3A,M3B metric
    class RANK_MODE decision
    class FLAT,CATW,INTER,FINAL,SORT stage4
    class RESULT output
```